# Google Apps Script Web App Deployment URL (Server-side & scripts/sync-papers.mjs build-time sync)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Google Apps Script Shared Secret Key (kept secure on server & scripts/sync-papers.mjs build-time sync)
APPS_SCRIPT_SECRET=YOUR_APPS_SCRIPT_SECRET_KEY

# Razorpay Credentials (Server-side only)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# Flag for internal preview/testing only: set to 'true' to allow simulated test checkout without real keys
ALLOW_PAYMENT_SIMULATION=false

# PYQ Beta Gate (default ON: true; set to 'false' to disable the beta gate and view full catalog)
PYQ_BETA_GATE=true
NEXT_PUBLIC_PYQ_BETA_GATE=true
